{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "registrodellegadas",
  "main": "src/index.js",
  "compatibility_date": "2026-07-30",
  "assets": {
    "directory": "./public"
  },
  "kv_namespaces": [
    {
      "binding": "TORRE_KV",
      "id": "3b7bbfbd82d0459f88fefd707da6507d"
    }
  ],
  "triggers": {
    "crons": ["0 6 * * *", "0 6 * * 1"]
  },

  // IMPORTANTE: mantiene viva la URL *.workers.dev como respaldo, incluso después de agregar un
  // dominio propio. Sin esto, Cloudflare la apaga por defecto en cuanto detecta "routes" abajo —
  // y si el dominio propio llegara a fallar (como pasó: la zona docklytc.com no se encontró en esta
  // cuenta), te quedarías sin ninguna URL funcionando. Con esto, siempre hay una de respaldo.
  "workers_dev": true,

  // ---- Dominio propio: como docklytc.com ya está registrado con Cloudflare (queda activo como zona
  // automáticamente), Wrangler puede conectarlo solo al desplegar — crea el registro DNS y el
  // certificado SSL por su cuenta, sin ningún paso manual en el dashboard.
  // Producción sigue respondiendo también en registrodellegadas.<tu-cuenta>.workers.dev; esta ruta
  // simplemente agrega docklytc.com como una puerta de entrada adicional al mismo Worker.
  //
  // REQUISITO: docklytc.com debe aparecer como zona activa en la MISMA cuenta de Cloudflare donde
  // vive este Worker (sección "Sitios web" / "Dominios" del dashboard). Si no aparece ahí, el
  // despliegue fallará con "Can't infer zone from route" — o el registro no terminó de pagarse, o
  // quedó en otra cuenta de Cloudflare distinta a esta.
  "routes": [
    { "pattern": "docklytc.com", "custom_domain": true }
  ],

  // ---- Entorno de preview: un Worker aparte ("registrodellegadas-preview"), con su propia base de
  // datos (KV) separada de la real. Sirve para probar cambios sin arriesgar datos de proveedores ni
  // citas reales. Se despliega con: npx wrangler deploy --env preview
  // (el despliegue normal, "npx wrangler deploy" sin --env, sigue publicando a producción igual que siempre).
  //
  // Antes del primer despliegue, crea el namespace de KV para preview con:
  //   npx wrangler kv namespace create TORRE_KV_PREVIEW
  // y pega el "id" que te devuelva en el campo de abajo (reemplaza "PON_AQUI_EL_ID_DEL_NAMESPACE_DE_PREVIEW").
  "env": {
    "preview": {
      "name": "registrodellegadas-preview",
      "main": "src/index.js",
      "compatibility_date": "2026-07-30",
      "assets": {
        "directory": "./public"
      },
      "workers_dev": true,
      "kv_namespaces": [
        {
          "binding": "TORRE_KV",
          "id": "PON_AQUI_EL_ID_DEL_NAMESPACE_DE_PREVIEW"
        }
      ],
      // preview.docklytc.com queda dedicado solo al entorno de pruebas, para no confundirlo con producción.
      "routes": [
        { "pattern": "preview.docklytc.com", "custom_domain": true }
      ],
      "triggers": {
        // Sin crons en preview: no necesita respaldos automáticos diarios de datos de prueba.
        "crons": []
      }
    }
  }
}
