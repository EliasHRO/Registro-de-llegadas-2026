{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "registrodellegadas",
  "main": "src/index.js",
  "compatibility_date": "2026-07-30",
  "assets": {
    "directory": "./public"
  },
  "kv_namespaces": [
    {
      "binding": "TORRE_KV",
      "id": "3b7bbfbd82d0459f88fefd707da6507d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "torre-control-backups"
    }
  ],
  "triggers": {
    "crons": ["0 6 * * *", "0 6 * * 1"]
  }
}
